<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | Eco Acolhe</title>
    <link rel="stylesheet" href="/css/estilo.css">
</head>
<body>
    <main>
        <%- include('../partials/headerCliente') %>
    

    <section class="boas-vindas">
        <h1>Olá, Pedro!</h1>
        <p>Visão geral do mês</p>
    </section>

    <section class="resumo" aria-label="Resumo do mês">

        <article class="card-resumo">
            <h2>Total reciclado</h2>
            <p>24,2 kg</p>
        </article>

        <article class="card-resumo">
            <h2>Itens reciclados</h2>
            <p>12</p>
        </article>

        <article class="card-resumo">
            <h2>Pontos acumulados</h2>
            <p>1.230 pts</p>
        </article>

        <article class="card-resumo">
            <h2>Resgates</h2>
            <p>3</p>
        </article>

    </section>

    <section class="reciclagem">
        <h2>Reciclagem por material</h2>
        <figure class="grafico-materiais">
            <figcaption>Distribuição dos materiais reciclados</figcaption>
            <ul class="legenda-materiais">
                <li>Papel</li>
                <li>Plástico</li>
                <li>Metal</li>
                <li>Vidro</li>
            </ul>
        </figure>
    </section>

  <section class="atividades">

    <div class="titulo-atividades">
        <h2>Atividades recentes</h2>
        <a href="/pedidos">Ver todas</a>
    </div>

    <article class="atividade">
        <span class="icone-atividade">♻</span>

        <div class="descricao-atividade">
            <h3>Reciclagem registrada!</h3>
            <p>Registro de materiais recicláveis.</p>
        </div>
    </article>

    <article class="atividade">
        <span class="icone-atividade">🎁</span>

        <div class="descricao-atividade">
            <h3>Produto resgatado!</h3>
            <p>2,5 kg de materiais recicláveis</p>
        </div>
    </article>

</section> 

    <%- include('../partials/navCliente') %>

    </main>
</body>
</html>