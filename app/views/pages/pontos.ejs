<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/estilo.css">
    <title>Meus pontos | Eco Acolhe</title>
</head>
<body>

    <main>
        <%- include('../partials/headerCliente') %>

        <section class="saldo">
          <article class="card-saldo">  
                <h2>Meu saldo</h2>
                <p class="valor-saldo">1.230<span>pontos</span></p>
                <p>Continue reciclando para ganhar mais!</p>
            </article>
        </section>

        <section class="resumo-pontos">
            <article class="card-pontos">
                <h2>Pontos recebidos</h2>
                <p>1.230 pts</p>
            </article>

            <article class="card-pontos">
                <h2>Pontos utilizados</h2>
                <p>-750 pts</p>
            </article>
        </section>

        <section class="atividades">

        </section>
            <div class="titulo-atividades">
                <h2>Atividades recentes</h2>
                <a href="/pedidos">Ver todas ›</a>
            </div>

        <article class="atividade">
            <span class="icone-atividade">♻️</span>

            <div class="descricao-atividade">
                <h3>Reciclagem</h3>
                <p>28/09/26</p>
            </div>

            <span class="pontos-atividade">+250 pts</span>
        </article>
    </section>
        <%- include('../partials/navCliente') %>
    </main>

</body>
</html>